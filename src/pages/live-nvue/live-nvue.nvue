<template>
  <view class="page">
    <view v-if="!isFullscreen" class="header" :style="{ height: headerHeight + 'px', paddingTop: statusBarHeight + 'px' }">
      <view class="header-button" @click="goBack"><text class="back-icon">‹</text></view>
      <view class="header-title"><text class="title">客厅摄像头</text><text class="subtitle">滨江公寓 · 01号设备</text></view>
      <view class="header-button" @click="showToast('设备设置将在完整版本中开放')"><text class="more-icon">•••</text></view>
    </view>

    <view class="viewer" :style="viewerStyle">
      <web-view v-if="webviewSrc" ref="liveWebview" class="webview" :src="webviewSrc" :webview-styles="webviewStyles" @onPostMessage="onWebviewMessage"></web-view>
      <view v-else class="fallback"><text class="fallback-text">当前平台暂不支持直播播放</text></view>

      <view class="cover" v-if="!isFullscreen && !isPlaying && !isLoading" @click="togglePlay">
        <view class="cover-button"><text class="cover-play">▶</text></view>
        <text class="cover-text">点击播放实时画面</text>
      </view>
      <view v-if="!isFullscreen" class="video-top" :class="{ hidden: !controlsVisible }">
        <view class="live-pill"><view class="live-dot"></view><text class="pill-text">实时</text></view>
        <view class="quality-pill" @click="showToast('当前画质：高清 1080P')"><text class="pill-text">高清 1080P</text></view>
      </view>
      <view v-if="!isFullscreen" class="video-bottom" :class="{ hidden: !controlsVisible }">
        <text class="timestamp">{{ timestamp }}</text>
        <view class="video-actions">
          <view class="video-button" @click="togglePlay"><text class="video-icon">{{ isPlaying ? 'Ⅱ' : '▶' }}</text></view>
          <view class="video-button" @click="toggleFullscreen"><text class="fullscreen-icon">{{ isFullscreen ? '⌟⌜' : '⌜⌟' }}</text></view>
        </view>
      </view>
    </view>

    <!-- Android WebView 内的事件桥在部分基座中不会即时执行。全屏时由 nvue
         原生热区覆盖同位置按钮，视觉仍由播放器绘制，页面自身退出全屏并恢复竖屏。 -->
    <view v-if="isFullscreen" class="fullscreen-back-hitbox" @click.stop="exitFullscreen(true)"></view>

    <scroller v-if="!isFullscreen" class="content" :style="contentStyle">
      <view class="status-row">
        <view><text class="device-name">客厅 · 主视角</text><text class="device-detail">连接稳定 · 延迟 0.8 秒</text></view>
        <view class="online"><view class="online-dot"></view><text class="online-text">设备在线</text></view>
      </view>

      <view class="timeline"><text class="timeline-text timeline-start">19:30</text><view class="track" :style="{ width: trackWidth + 'px' }"><view class="track-active" :style="{ width: trackActiveWidth + 'px' }"></view><view class="track-knob" :style="{ left: trackKnobLeft + 'px' }"></view></view><text class="timeline-text timeline-end">现在</text></view>

      <text class="section-label">快捷操作</text>
      <view class="quick-actions">
        <view class="action" :style="actionStyle" @click="showToast('截图功能等待业务接口接入')">
          <view class="camera-icon"><view class="camera-top"></view><view class="camera-lens"></view></view>
          <text class="action-text">截图</text>
        </view>
        <view class="action" :style="actionStyle" @click="showToast('录像功能等待业务接口接入')">
          <view class="record-icon"><view class="record-dot"></view></view>
          <text class="action-text">录像</text>
        </view>
        <view class="action" :style="actionStyle" @click="showToast('对讲功能等待业务接口接入')">
          <view class="mic-icon"><view class="mic-capsule"></view><view class="mic-arc"></view><view class="mic-stem"></view><view class="mic-base"></view></view>
          <text class="action-text">对讲</text>
        </view>
        <view class="action" :style="actionStyle" @click="showToast('回放功能等待业务接口接入')">
          <view class="clock-icon"><view class="clock-hand-hour"></view><view class="clock-hand-minute"></view></view>
          <text class="action-text">回放</text>
        </view>
      </view>

      <text class="section-label">云台控制</text>
      <view class="ptz-card" :style="{ width: contentWidth + 'px' }">
        <view class="dpad" :style="{ width: dpadColumnWidth + 'px' }">
          <view class="dpad-row"><view class="dpad-empty"></view><view class="dpad-key up" @click="showToast('摄像头向上移动')"><text class="dpad-text">↑</text></view><view class="dpad-empty"></view></view>
          <view class="dpad-row"><view class="dpad-key left" @click="showToast('摄像头向左移动')"><text class="dpad-text">←</text></view><view class="dpad-center" @click="showToast('云台回到中心')"><text class="center-dot">●</text></view><view class="dpad-key right" @click="showToast('摄像头向右移动')"><text class="dpad-text">→</text></view></view>
          <view class="dpad-row"><view class="dpad-empty"></view><view class="dpad-key down" @click="showToast('摄像头向下移动')"><text class="dpad-text">↓</text></view><view class="dpad-empty"></view></view>
        </view>
        <view class="zoom" :style="{ width: zoomColumnWidth + 'px' }"><text class="zoom-title">画面缩放</text><text class="zoom-copy">也可在画面上双指缩放</text><view class="stepper"><view class="step-button" @click="changeZoom(-0.1)"><text class="step-text">−</text></view><view class="zoom-value"><text class="zoom-value-text">{{ zoom.toFixed(1) }}×</text></view><view class="step-button" @click="changeZoom(0.1)"><text class="step-text">+</text></view></view></view>
      </view>
      <view class="bottom-space"></view>
    </scroller>

    <view v-if="toastVisible" class="toast"><text class="toast-text">{{ toastText }}</text></view>
  </view>
</template>

<script>
const FLV_URL = 'https://srs.unsj.edu.ar/live/xama/xama.flv'
const PLAYER_UI_VERSION = '20260815-2'
const HEADER_CONTENT_HEIGHT = 64
const VIEWER_RATIO = 284 / 390
const LANDSCAPE_GAMMA_THRESHOLD = 55
const PORTRAIT_GAMMA_THRESHOLD = 30
const PORTRAIT_BETA_THRESHOLD = 45

export default {
  data() {
    return {
      webviewSrc: '', statusBarHeight: 0, windowHeight: 0, windowWidth: 390,
      safeAreaTop: 0, safeAreaLeft: 0,
      isPlaying: false, isLoading: false, isFullscreen: false,
      controlsVisible: true, hideControlsTimer: null,
      webviewStyles: { bounce: 'none', scrollIndicator: 'none', scalable: false },
      timestamp: '', clockTimer: null, toastVisible: false, toastText: '', toastTimer: null, zoom: 1,
      orientationWatchId: null, physicalOrientation: 'portrait',
      suppressAutoFullscreenUntilPortrait: false, isLeaving: false,
    }
  },
  computed: {
    headerHeight() { return this.statusBarHeight + HEADER_CONTENT_HEIGHT },
    viewerHeight() { return Math.max(210, Math.min(284, this.windowWidth * VIEWER_RATIO)) },
    viewerStyle() {
      if (this.isFullscreen) return { top: '0px', height: this.windowHeight + 'px' }
      return { top: this.headerHeight + 'px', height: this.viewerHeight + 'px' }
    },
    contentStyle() {
      const top = this.headerHeight + this.viewerHeight
      return { top: top + 'px', height: Math.max(0, this.windowHeight - top) + 'px' }
    },
    contentWidth() { return Math.max(0, this.windowWidth - 28) },
    actionWidth() { return Math.floor((this.contentWidth - 24) / 4) },
    actionStyle() { return { width: this.actionWidth + 'px' } },
    trackWidth() { return Math.max(120, this.contentWidth - 88) },
    trackActiveWidth() { return Math.floor(this.trackWidth * 0.72) },
    trackKnobLeft() { return this.trackActiveWidth - 5 },
    dpadColumnWidth() { return Math.min(142, Math.floor(this.contentWidth * 0.42)) },
    zoomColumnWidth() { return Math.max(116, this.contentWidth - this.dpadColumnWidth - 40) },
  },
  onLoad() {
    this.updateWindowMetrics()
    // #ifdef APP-PLUS
    plus.screen.lockOrientation('portrait-primary')
    plus.navigator.setFullscreen(false)
    this.startOrientationWatcher()
    // #endif
    this.webviewSrc = '/hybrid/html/flv-player.html?url=' + encodeURIComponent(FLV_URL) + '&uiVersion=' + PLAYER_UI_VERSION
    this.updateTimestamp()
    this.clockTimer = setInterval(this.updateTimestamp, 1000)
  },
  onUnload() {
    this.stopOrientationWatcher()
    this.clearAutoHideTimer()
    if (this.clockTimer) clearInterval(this.clockTimer)
    if (this.toastTimer) clearTimeout(this.toastTimer)
    // #ifdef APP-PLUS
    plus.screen.lockOrientation('portrait-primary')
    plus.navigator.setFullscreen(false)
    // #endif
  },
  onResize() {
    this.updateWindowMetrics()
  },
  onBackPress() {
    if (this.isFullscreen) {
      this.exitFullscreen(true)
      return true
    }
    this.restorePortraitMode()
    return false
  },
  methods: {
    updateWindowMetrics() {
      const info = uni.getSystemInfoSync()
      this.statusBarHeight = info.statusBarHeight || 0
      this.windowHeight = info.windowHeight || info.screenHeight || 0
      this.windowWidth = info.windowWidth || info.screenWidth || 390
      const insets = info.safeAreaInsets || {}
      this.safeAreaTop = Number(insets.top) || 0
      this.safeAreaLeft = Number(insets.left) || 0
    },
    restorePortraitMode() {
      // #ifdef APP-PLUS
      plus.screen.lockOrientation('portrait-primary')
      plus.navigator.setFullscreen(false)
      // #endif
    },
    startOrientationWatcher() {
      // #ifdef APP-PLUS
      if (this.orientationWatchId !== null || !plus.orientation) return
      this.orientationWatchId = plus.orientation.watchOrientation(
        rotation => this.handlePhysicalOrientation(rotation),
        error => console.warn('[live-nvue orientation]', error),
        { frequency: 250 }
      )
      // #endif
    },
    stopOrientationWatcher() {
      // #ifdef APP-PLUS
      if (this.orientationWatchId !== null && plus.orientation) {
        plus.orientation.clearWatch(this.orientationWatchId)
        this.orientationWatchId = null
      }
      // #endif
    },
    handlePhysicalOrientation(rotation) {
      if (!rotation || this.isLeaving) return
      const gamma = Math.abs(Number(rotation.gamma))
      const beta = Math.abs(Number(rotation.beta))
      if (!Number.isFinite(gamma) || !Number.isFinite(beta)) return

      if (gamma >= LANDSCAPE_GAMMA_THRESHOLD && beta < PORTRAIT_BETA_THRESHOLD) {
        if (this.physicalOrientation !== 'landscape') this.physicalOrientation = 'landscape'
        if (!this.isFullscreen && !this.suppressAutoFullscreenUntilPortrait) this.enterFullscreen()
      } else if (gamma <= PORTRAIT_GAMMA_THRESHOLD && beta >= PORTRAIT_BETA_THRESHOLD) {
        this.physicalOrientation = 'portrait'
        this.suppressAutoFullscreenUntilPortrait = false
      }
    },
    goBack() { this.restorePortraitAndBack() },
    restorePortraitAndBack() {
      if (this.isLeaving) return
      this.isLeaving = true
      this.stopOrientationWatcher()
      this.isFullscreen = false
      this.evalInWebview('fullscreen_exit')
      this.restorePortraitMode()
      setTimeout(() => uni.navigateBack({ delta: 1 }), 80)
    },
    evalInWebview(action) {
      if (this.$refs.liveWebview) this.$refs.liveWebview.evalJS("window.dispatchEvent(new CustomEvent('uni-app-command', { detail: { action: '" + action + "' } }))")
    },
    togglePlay() {
      if (this.isPlaying) {
        this.evalInWebview('pause')
        this.isPlaying = false
      } else {
        this.evalInWebview('play')
        this.isPlaying = true
      }
      this.isLoading = false
      this.showControls()
    },
    toggleFullscreen() {
      this.isFullscreen ? this.exitFullscreen(true) : this.enterFullscreen()
    },
    enterFullscreen() {
      if (this.isFullscreen || this.isLeaving) return
      this.isFullscreen = true
      this.evalInWebview('fullscreen_enter')
      // #ifdef APP-PLUS
      plus.screen.unlockOrientation()
      plus.navigator.setFullscreen(true)
      // #endif
      this.hideControls()
      this.$nextTick(this.updateWindowMetrics)
    },
    exitFullscreen(suppressAutoEnter) {
      this.isFullscreen = false
      // 用户主动退出后必须等设备真正回到竖屏，才允许下一次横屏自动进入。
      // 部分 Android 设备在 UI 已横屏时仍会短暂上报旧的传感器方向，不能依赖
      // physicalOrientation === 'landscape'，否则退出后会被监听器立即重新拉回全屏。
      this.suppressAutoFullscreenUntilPortrait = Boolean(suppressAutoEnter)
      this.evalInWebview('fullscreen_exit')
      this.restorePortraitMode()
      this.showControls()
      this.$nextTick(this.updateWindowMetrics)
    },
    clearAutoHideTimer() { if (this.hideControlsTimer) { clearTimeout(this.hideControlsTimer); this.hideControlsTimer = null } },
    showControls() { this.controlsVisible = true; this.clearAutoHideTimer(); if (this.isPlaying) this.hideControlsTimer = setTimeout(this.hideControls, 3000) },
    hideControls() { this.controlsVisible = false; this.clearAutoHideTimer() },
    showToast(text) { this.toastText = text; this.toastVisible = true; if (this.toastTimer) clearTimeout(this.toastTimer); this.toastTimer = setTimeout(() => { this.toastVisible = false }, 1700) },
    changeZoom(delta) { this.zoom = Math.max(0.5, Math.min(3, Number((this.zoom + delta).toFixed(1)))); this.showToast('画面缩放 ' + this.zoom.toFixed(1) + '×') },
    updateTimestamp() { const d = new Date(); const p = n => String(n).padStart(2, '0'); this.timestamp = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + '  ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()) },
    onWebviewMessage(event) {
      const msg = this.extractMessage(event)
      if (!msg) return
      if (msg.type === 'play_success' || msg.type === 'first_frame') { this.isPlaying = true; this.isLoading = false; this.showControls() }
      else if (msg.type === 'paused' || msg.type === 'play_rejected' || msg.type === 'error') { this.isPlaying = false; this.isLoading = false; this.showControls() }
      else if (msg.type === 'toggle_controls') { this.controlsVisible ? this.hideControls() : this.showControls() }
      else if (msg.type === 'request_back') this.restorePortraitAndBack()
      else if (msg.type === 'request_fullscreen_exit') this.exitFullscreen(true)
    },
    extractMessage(event) {
      let msg = event && event.detail && event.detail.data !== undefined ? event.detail.data : event
      for (let depth = 0; depth < 6 && msg && !msg.type; depth += 1) {
        if (Array.isArray(msg)) msg = msg[0]
        else if (msg.detail !== undefined) msg = msg.detail
        else if (msg.data !== undefined) msg = msg.data
        else break
      }
      return msg
    },
  },
}
</script>

<style>
.page { flex:1; background-color:#f5f7f5; }
.header { position:absolute; left:0; right:0; top:0; z-index:10; flex-direction:row; align-items:center; padding-left:10px; padding-right:10px; background-color:#111413; }
.header-button { width:48px; height:64px; align-items:center; justify-content:center; }.back-icon { color:#fff; font-size:32px; font-weight:300; }.more-icon { color:#fff; font-size:18px; font-weight:700; }
.header-title { flex:1; align-items:center; justify-content:center; }.title { color:#fff; font-size:16px; line-height:21px; font-weight:700; }.subtitle { color:rgba(255,255,255,.58); font-size:11px; line-height:16px; }
.viewer { position:absolute; left:0; right:0; z-index:2; overflow:hidden; background-color:#131615; }.webview,.fallback { position:absolute; left:0; right:0; top:0; bottom:0; }.fallback { align-items:center; justify-content:center; }.fallback-text { color:#fff; font-size:13px; }
.fullscreen-back-hitbox { position:absolute; left:0; top:0; z-index:40; width:128px; height:80px; background-color:rgba(0,0,0,.01); }
.cover { position:absolute; left:0; right:0; top:0; bottom:0; z-index:5; align-items:center; justify-content:center; background-color:rgba(17,20,19,.55); }.cover-button { width:62px; height:62px; margin-bottom:12px; align-items:center; justify-content:center; border-width:1px; border-style:solid; border-color:rgba(255,255,255,.22); border-radius:31px; background-color:rgba(12,15,14,.66); }.cover-play { margin-left:3px; color:#fff; font-size:24px; }.cover-text { color:rgba(255,255,255,.78); font-size:12px; }
.video-top,.video-bottom { position:absolute; left:14px; right:14px; z-index:7; flex-direction:row; align-items:center; justify-content:space-between; }.video-top { top:14px; }.video-bottom { bottom:13px; }.hidden { opacity:0; }
.live-pill,.quality-pill { height:26px; padding-left:8px; padding-right:8px; flex-direction:row; align-items:center; border-width:1px; border-style:solid; border-color:rgba(255,255,255,.13); border-radius:5px; background-color:rgba(12,15,14,.65); }.live-dot { width:6px; height:6px; margin-right:6px; border-radius:3px; background-color:#ff5b47; }.pill-text { color:#fff; font-size:11px; font-weight:700; }.timestamp { color:#fff; font-size:11px; font-weight:600; }.video-actions { flex-direction:row; }.video-button { width:38px; height:38px; margin-left:4px; align-items:center; justify-content:center; border-radius:19px; background-color:rgba(12,15,14,.62); }.video-icon { color:#fff; font-size:16px; }.fullscreen-icon { color:#fff; font-size:15px; }
.content { position:absolute; left:0; right:0; z-index:1; padding:14px; background-color:#f5f7f5; }.status-row { margin-bottom:13px; flex-direction:row; align-items:flex-start; justify-content:space-between; }.device-name { color:#161818; font-size:15px; line-height:22px; font-weight:700; }.device-detail { color:#737977; font-size:11px; line-height:17px; }.online { margin-top:4px; flex-direction:row; align-items:center; }.online-dot { width:7px; height:7px; margin-right:6px; border-radius:4px; background-color:#28a06a; }.online-text { color:#247b55; font-size:11px; font-weight:700; }
.timeline { height:45px; margin-bottom:16px; padding-left:12px; padding-right:12px; flex-direction:row; align-items:center; border-width:1px; border-style:solid; border-color:#e5e8e6; border-radius:6px; background-color:#fff; }.timeline-text { color:#737977; font-size:10px; }.timeline-start { width:28px; }.timeline-end { width:20px; text-align:right; }.track { position:relative; height:2px; margin-left:8px; margin-right:8px; background-color:#dfe3e0; }.track-active { height:2px; background-color:#161818; }.track-knob { position:absolute; top:-4px; width:10px; height:10px; border-width:2px; border-style:solid; border-color:#fff; border-radius:5px; background-color:#161818; }
.section-label { margin-bottom:9px; color:#737977; font-size:11px; line-height:16px; font-weight:700; }.quick-actions { margin-bottom:17px; flex-direction:row; justify-content:space-between; }.action { height:72px; align-items:center; justify-content:center; border-width:1px; border-style:solid; border-color:#e5e8e6; border-radius:6px; background-color:#fff; }.action-text { margin-top:6px; color:#161818; font-size:11px; line-height:15px; font-weight:600; text-align:center; }
.camera-icon { position:relative; width:20px; height:15px; margin-top:3px; border-width:1.5px; border-style:solid; border-color:#161818; border-radius:2px; align-items:center; justify-content:center; }.camera-top { position:absolute; left:5px; top:-4px; width:8px; height:4px; border-top-left-radius:2px; border-top-right-radius:2px; background-color:#161818; }.camera-lens { width:6px; height:6px; border-width:1.5px; border-style:solid; border-color:#161818; border-radius:3px; }
.record-icon { width:20px; height:20px; align-items:center; justify-content:center; border-width:1.5px; border-style:solid; border-color:#161818; border-radius:10px; }.record-dot { width:6px; height:6px; border-radius:3px; background-color:#161818; }
.mic-icon { position:relative; width:20px; height:22px; align-items:center; }.mic-capsule { width:7px; height:13px; border-width:1.5px; border-style:solid; border-color:#161818; border-radius:4px; }.mic-arc { position:absolute; left:4px; top:7px; width:12px; height:9px; border-left-width:1.5px; border-right-width:1.5px; border-bottom-width:1.5px; border-style:solid; border-color:#161818; border-bottom-left-radius:7px; border-bottom-right-radius:7px; }.mic-stem { position:absolute; left:9px; top:16px; width:1.5px; height:4px; background-color:#161818; }.mic-base { position:absolute; left:6px; top:20px; width:8px; height:1.5px; background-color:#161818; }
.clock-icon { position:relative; width:20px; height:20px; border-width:1.5px; border-style:solid; border-color:#161818; border-radius:10px; }.clock-hand-hour { position:absolute; left:9px; top:4px; width:1.5px; height:6px; background-color:#161818; }.clock-hand-minute { position:absolute; left:9px; top:9px; width:5px; height:1.5px; background-color:#161818; }
.ptz-card { height:138px; padding:12px; flex-direction:row; align-items:center; border-width:1px; border-style:solid; border-color:#e5e8e6; border-radius:6px; background-color:#fff; }.dpad { width:142px; align-items:center; }.dpad-row { height:36px; flex-direction:row; }.dpad-key,.dpad-empty,.dpad-center { width:36px; height:36px; align-items:center; justify-content:center; }.dpad-key { background-color:#f0f2f0; }.up { border-top-left-radius:5px; border-top-right-radius:5px; }.left { border-top-left-radius:5px; border-bottom-left-radius:5px; }.right { border-top-right-radius:5px; border-bottom-right-radius:5px; }.down { border-bottom-left-radius:5px; border-bottom-right-radius:5px; }.dpad-center { border-radius:18px; background-color:#161818; }.dpad-text { color:#3f4542; font-size:16px; }.center-dot { color:#fff; font-size:10px; }.zoom { flex:1; }.zoom-title { color:#161818; font-size:13px; font-weight:700; }.zoom-copy { margin-top:5px; margin-bottom:14px; color:#737977; font-size:10px; }.stepper { height:38px; flex-direction:row; border-width:1px; border-style:solid; border-color:#e5e8e6; border-radius:5px; overflow:hidden; }.step-button { width:38px; align-items:center; justify-content:center; background-color:#f6f7f6; }.step-text { color:#161818; font-size:18px; }.zoom-value { flex:1; align-items:center; justify-content:center; border-left-width:1px; border-right-width:1px; border-style:solid; border-color:#e5e8e6; }.zoom-value-text { color:#161818; font-size:11px; font-weight:700; }.bottom-space { height:28px; }
.toast { position:absolute; left:50px; right:50px; bottom:24px; z-index:30; height:38px; padding-left:14px; padding-right:14px; align-items:center; justify-content:center; border-radius:6px; background-color:rgba(20,23,22,.93); }.toast-text { color:#fff; font-size:12px; text-align:center; }
</style>
